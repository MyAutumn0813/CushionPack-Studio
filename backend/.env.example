# Express backend port.
PORT=8787

# R installation hints for the Node backend.
# Set at least one of these in production if Rscript is not already on PATH.
R_HOME=
RSCRIPT_PATH=

# Internal plumber service settings.
R_PLUMBER_HOST=127.0.0.1
R_PLUMBER_PORT=8791
R_PLUMBER_HEALTH_TIMEOUT_MS=15000

# Set to 1 only if plumber is managed outside server.mjs.
R_PLUMBER_EXTERNAL=0
